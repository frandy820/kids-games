{"region":5,"sentences":[
{"id":"s082","region":5,"text":"月亮在水中。","focus":"中","py":"yuè liàng zài shuǐ zhōng","len":5},
{"id":"s083","region":5,"text":"我在桥上看鱼。","focus":"桥","py":"wǒ zài qiáo shàng kàn yú","len":6},
{"id":"s084","region":5,"text":"坐车去看爷爷。","focus":"车","py":"zuò chē qù kàn yé ye","len":6},
{"id":"s085","region":5,"text":"去奶奶家的路好远。","focus":"路","py":"qù nǎi nai jiā de lù hǎo yuǎn","len":8},
{"id":"s086","region":5,"text":"红灯亮了，我看见了。","focus":"灯","py":"hóng dēng liàng le wǒ kàn jiàn le","len":8},
{"id":"s087","region":5,"text":"和妈妈在路上走。","focus":"走","py":"hé mā ma zài lù shàng zǒu","len":7},
{"id":"s088","region":5,"text":"水里有鱼和虾。","focus":"里","py":"shuǐ lǐ yǒu yú hé xiā","len":6},
{"id":"s089","region":5,"text":"船在水上走。","focus":"船","py":"chuán zài shuǐ shàng zǒu","len":5},
{"id":"s090","region":5,"text":"东湖里有莲花。","focus":"东","py":"dōng hú lǐ yǒu lián huā","len":6},
{"id":"s091","region":5,"text":"南山上有白马。","focus":"南","py":"nán shān shàng yǒu bái mǎ","len":6},
{"id":"s092","region":5,"text":"日头下西山。","focus":"西","py":"rì tóu xià xī shān","len":5},
{"id":"s093","region":5,"text":"北山下了雪，好白呀！","focus":"北","py":"běi shān xià le xuě hǎo bái ya","len":8},
{"id":"s094","region":5,"text":"我走在妈妈前头。","focus":"前","py":"wǒ zǒu zài mā ma qián tou","len":7},
{"id":"s095","region":5,"text":"我在爸爸后头走。","focus":"后","py":"wǒ zài bà ba hòu tou zǒu","len":7},
{"id":"s096","region":5,"text":"我的左手上有花。","focus":"左","py":"wǒ de zuǒ shǒu shàng yǒu huā","len":7},
{"id":"s097","region":5,"text":"妈妈在左，我在右。","focus":"右","py":"mā ma zài zuǒ wǒ zài yòu","len":7},
{"id":"s098","region":5,"text":"和爸爸出门买菜。","focus":"门","py":"hé bà ba chū mén mǎi cài","len":7},
{"id":"s099","region":5,"text":"走进树林看鸟。","focus":"进","py":"zǒu jìn shù lín kàn niǎo","len":6},
{"id":"s100","region":5,"text":"我来找你！","focus":"找","py":"wǒ lái zhǎo nǐ","len":4},
{"id":"s101","region":5,"text":"天黑了，回家吧。","focus":"回","py":"tiān hēi le huí jiā ba","len":6},
{"id":"s102","region":5,"text":"去医院看奶奶。","focus":"院","py":"qù yī yuàn kàn nǎi nai","len":6},
{"id":"s103","region":5,"text":"去超市，还是去蛋糕店？","focus":"店","py":"qù chāo shì hái shì qù dàn gāo diàn","len":9}
]}
