{"region":6,"sentences":[
{"id":"s104","region":6,"text":"我和妈妈看书。","focus":"书","py":"wǒ hé mā ma kàn shū","len":6},
{"id":"s105","region":6,"text":"我的书包不见了。","focus":"包","py":"wǒ de shū bāo bú jiàn le","len":7},
{"id":"s106","region":6,"text":"爸爸给我买尺。","focus":"尺","py":"bà ba gěi wǒ mǎi chǐ","len":6},
{"id":"s107","region":6,"text":"作业本在书包里。","focus":"本","py":"zuò yè běn zài shū bāo lǐ","len":7},
{"id":"s108","region":6,"text":"我有红笔和黑笔。","focus":"笔","py":"wǒ yǒu hóng bǐ hé hēi bǐ","len":7},
{"id":"s109","region":6,"text":"我们上课了。","focus":"课","py":"wǒ men shàng kè le","len":5},
{"id":"s110","region":6,"text":"早上我们升国旗。","focus":"旗","py":"zǎo shang wǒ men shēng guó qí","len":7},
{"id":"s111","region":6,"text":"我和妹妹画画。","focus":"画","py":"wǒ hé mèi mei huà huà","len":6},
{"id":"s112","region":6,"text":"我的字好看。","focus":"字","py":"wǒ de zì hǎo kàn","len":5},
{"id":"s113","region":6,"text":"我看看生词。","focus":"词","py":"wǒ kàn kan shēng cí","len":5},
{"id":"s114","region":6,"text":"书在桌子上。","focus":"桌","py":"shū zài zhuō zi shang","len":5},
{"id":"s115","region":6,"text":"白纸上有画。","focus":"纸","py":"bái zhǐ shang yǒu huà","len":5},
{"id":"s116","region":6,"text":"我写字给妈妈看。","focus":"写","py":"wǒ xiě zì gěi mā ma kàn","len":7},
{"id":"s117","region":6,"text":"老师早上好！","focus":"师","py":"lǎo shī zǎo shang hǎo","len":5},
{"id":"s118","region":6,"text":"桌子上有六本书。","focus":"六","py":"zhuō zi shang yǒu liù běn shū","len":7},
{"id":"s119","region":6,"text":"我有十根手指。","focus":"十","py":"wǒ yǒu shí gēn shǒu zhǐ","len":6},
{"id":"s120","region":6,"text":"我有语文书。","focus":"文","py":"wǒ yǒu yǔ wén shū","len":5},
{"id":"s121","region":6,"text":"来，我们数一数。","focus":"数","py":"lái wǒ men shǔ yi shǔ","len":6},
{"id":"s122","region":6,"text":"我去学校上课。","focus":"学","py":"wǒ qù xué xiào shàng kè","len":6},
{"id":"s123","region":6,"text":"图画书里有娃娃。","focus":"图","py":"tú huà shū lǐ yǒu wá wa","len":7},
{"id":"s124","region":6,"text":"我在学校读书。","focus":"读","py":"wǒ zài xué xiào dú shū","len":6},
{"id":"s125","region":6,"text":"书包上有名字。","focus":"名","py":"shū bāo shang yǒu míng zi","len":6}
]}
