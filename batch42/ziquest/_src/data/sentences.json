 "sentences": [
  {
   "id": "s001",
   "region": 1,
   "text": "风来了，雪来了。",
   "focus": "雪",
   "py": "fēng lái le xuě lái le",
   "len": 6
  },
  {
   "id": "s002",
   "region": 1,
   "text": "云是白的，雪还是白的。",
   "focus": "白",
   "py": "yún shì bái de xuě hái shì bái de",
   "len": 9
  },
  {
   "id": "s003",
   "region": 1,
   "text": "山有树和水。",
   "focus": "树",
   "py": "shān yǒu shù hé shuǐ",
   "len": 5
  },
  {
   "id": "s004",
   "region": 1,
   "text": "秋风来了，树叶红了。",
   "focus": "叶",
   "py": "qiū fēng lái le shù yè hóng le",
   "len": 8
  },
  {
   "id": "s005",
   "region": 1,
   "text": "月和星来了。",
   "focus": "星",
   "py": "yuè hé xīng lái le",
   "len": 5
  },
  {
   "id": "s006",
   "region": 1,
   "text": "我们去看红叶吧。",
   "focus": "看",
   "py": "wǒ men qù kàn hóng yè ba",
   "len": 7
  },
  {
   "id": "s007",
   "region": 1,
   "text": "我看见山和水了。",
   "focus": "见",
   "py": "wǒ kàn jiàn shān hé shuǐ le",
   "len": 7
  },
  {
   "id": "s008",
   "region": 1,
   "text": "江水闪呀闪。",
   "focus": "江",
   "py": "jiāng shuǐ shǎn ya shǎn",
   "len": 5
  },
  {
   "id": "s009",
   "region": 1,
   "text": "春天来了，我们去看莲。",
   "focus": "春",
   "py": "chūn tiān lái le wǒ men qù kàn lián",
   "len": 9
  },
  {
   "id": "s010",
   "region": 1,
   "text": "日来了，树有影了。",
   "focus": "影",
   "py": "rì lái le shù yǒu yǐng le",
   "len": 7
  },
  {
   "id": "s011",
   "region": 1,
   "text": "云黑了，雨来了。",
   "focus": "黑",
   "py": "yún hēi le yǔ lái le",
   "len": 6
  },
  {
   "id": "s012",
   "region": 1,
   "text": "看呀，天有彩云！",
   "focus": "彩",
   "py": "kàn ya tiān yǒu cǎi yún",
   "len": 6
  },
  {
   "id": "s013",
   "region": 1,
   "text": "春来了，树绿了。",
   "focus": "绿",
   "py": "chūn lái le shù lǜ le",
   "len": 6
  },
  {
   "id": "s014",
   "region": 1,
   "text": "海水来了，海水去了。",
   "focus": "海",
   "py": "hǎi shuǐ lái le hǎi shuǐ qù le",
   "len": 8
  },
  {
   "id": "s015",
   "region": 1,
   "text": "天黑了，月亮来了。",
   "focus": "亮",
   "py": "tiān hēi le yuè liàng lái le",
   "len": 7
  },
  {
   "id": "s016",
   "region": 1,
   "text": "山有洞，洞好黑。",
   "focus": "洞",
   "py": "shān yǒu dòng dòng hǎo hēi",
   "len": 6
  },
  {
   "id": "s017",
   "region": 1,
   "text": "山好高呀，树好绿。",
   "focus": "高",
   "py": "shān hǎo gāo ya shù hǎo lǜ",
   "len": 7
  },
  {
   "id": "s018",
   "region": 1,
   "text": "天晚了，山黑了。",
   "focus": "晚",
   "py": "tiān wǎn le shān hēi le",
   "len": 6
  },
  {
   "id": "s019",
   "region": 1,
   "text": "午来了，日好亮呀。",
   "focus": "午",
   "py": "wǔ lái le rì hǎo liàng ya",
   "len": 7
  },
  {
   "id": "s020",
   "region": 1,
   "text": "今天天好蓝呀。",
   "focus": "今",
   "py": "jīn tiān tiān hǎo lán ya",
   "len": 6
  },
  {
   "id": "s021",
   "region": 1,
   "text": "今年的雪好白呀。",
   "focus": "年",
   "py": "jīn nián de xuě hǎo bái ya",
   "len": 7
  },
  {
   "id": "s022",
   "region": 1,
   "text": "雾来了，山看不见了。",
   "focus": "雾",
   "py": "wù lái le shān kàn bu jiàn le",
   "len": 8
  },
  {
   "id": "s023",
   "region": 1,
   "text": "湖水绿，湖水亮。",
   "focus": "湖",
   "py": "hú shuǐ lǜ hú shuǐ liàng",
   "len": 6
  },
  {
   "id": "s024",
   "region": 1,
   "text": "海岛有树，还有雾。",
   "focus": "岛",
   "py": "hǎi dǎo yǒu shù hái yǒu wù",
   "len": 7
  },
  {
   "id": "s025",
   "region": 1,
   "text": "我们去江岸看水。",
   "focus": "岸",
   "py": "wǒ men qù jiāng àn kàn shuǐ",
   "len": 7
  },
  {
   "id": "s026",
   "region": 1,
   "text": "海岛的沙好白。",
   "focus": "沙",
   "py": "hǎi dǎo de shā hǎo bái",
   "len": 6
  },
  {
   "id": "s027",
   "region": 2,
   "text": "你看我的手，好白呀！",
   "focus": "手",
   "py": "nǐ kàn wǒ de shǒu hǎo bái ya",
   "len": 8
  },
  {
   "id": "s028",
   "region": 2,
   "text": "他站好了，你看！",
   "focus": "站",
   "py": "tā zhàn hǎo le nǐ kàn",
   "len": 6
  },
  {
   "id": "s029",
   "region": 2,
   "text": "坐好，我们听。",
   "focus": "坐",
   "py": "zuò hǎo wǒ men tīng",
   "len": 5
  },
  {
   "id": "s030",
   "region": 2,
   "text": "我爸好高呀！",
   "focus": "爸",
   "py": "wǒ bà hǎo gāo ya",
   "len": 5
  },
  {
   "id": "s031",
   "region": 2,
   "text": "我妈来看我了！",
   "focus": "妈",
   "py": "wǒ mā lái kàn wǒ le",
   "len": 6
  },
  {
   "id": "s032",
   "region": 2,
   "text": "妹，你去不去？",
   "focus": "妹",
   "py": "mèi nǐ qù bù qù",
   "len": 5
  },
  {
   "id": "s033",
   "region": 2,
   "text": "奶来了，我们坐好。",
   "focus": "奶",
   "py": "nǎi lái le wǒ men zuò hǎo",
   "len": 7
  },
  {
   "id": "s034",
   "region": 2,
   "text": "我家有爸和妈。",
   "focus": "家",
   "py": "wǒ jiā yǒu bà hé mā",
   "len": 6
  },
  {
   "id": "s035",
   "region": 2,
   "text": "我和妹，头对头。",
   "focus": "头",
   "py": "wǒ hé mèi tóu duì tóu",
   "len": 6
  },
  {
   "id": "s036",
   "region": 2,
   "text": "天黑了，我们去睡。",
   "focus": "睡",
   "py": "tiān hēi le wǒ men qù shuì",
   "len": 7
  },
  {
   "id": "s037",
   "region": 2,
   "text": "妹穿红，我穿绿。",
   "focus": "穿",
   "py": "mèi chuān hóng wǒ chuān lǜ",
   "len": 6
  },
  {
   "id": "s038",
   "region": 2,
   "text": "我的衣，红红的。",
   "focus": "衣",
   "py": "wǒ de yī hóng hóng de",
   "len": 6
  },
  {
   "id": "s039",
   "region": 2,
   "text": "我的衣服，蓝蓝的。",
   "focus": "服",
   "py": "wǒ de yī fú lán lán de",
   "len": 7
  },
  {
   "id": "s040",
   "region": 2,
   "text": "娃睡了，妈还没睡。",
   "focus": "娃",
   "py": "wá shuì le mā hái méi shuì",
   "len": 7
  },
  {
   "id": "s041",
   "region": 2,
   "text": "妹的牙，白白的。",
   "focus": "牙",
   "py": "mèi de yá bái bái de",
   "len": 6
  },
  {
   "id": "s042",
   "region": 2,
   "text": "我和哥去看云。",
   "focus": "哥",
   "py": "wǒ hé gē qù kàn yún",
   "len": 6
  },
  {
   "id": "s043",
   "region": 2,
   "text": "姐的衣服，好好看！",
   "focus": "姐",
   "py": "jiě de yī fú hǎo hǎo kàn",
   "len": 7
  },
  {
   "id": "s044",
   "region": 2,
   "text": "弟，你睡了吗？",
   "focus": "弟",
   "py": "dì nǐ shuì le ma",
   "len": 5
  },
  {
   "id": "s045",
   "region": 2,
   "text": "爷，你来坐呀！",
   "focus": "爷",
   "py": "yé nǐ lái zuò ya",
   "len": 5
  },
  {
   "id": "s046",
   "region": 2,
   "text": "我是女孩，你是男孩。",
   "focus": "女",
   "py": "wǒ shì nǚ hái nǐ shì nán hái",
   "len": 8
  },
  {
   "id": "s047",
   "region": 3,
   "text": "我看牛，牛看我。",
   "focus": "牛",
   "py": "wǒ kàn niú niú kàn wǒ",
   "len": 6
  },
  {
   "id": "s048",
   "region": 3,
   "text": "猫睡着了。",
   "focus": "猫",
   "py": "māo shuì zháo le",
   "len": 4
  },
  {
   "id": "s049",
   "region": 3,
   "text": "鸭和牛在禾田。",
   "focus": "鸭",
   "py": "yā hé niú zài hé tián",
   "len": 6
  },
  {
   "id": "s050",
   "region": 3,
   "text": "宝宝有木屋。",
   "focus": "木",
   "py": "bǎo bǎo yǒu mù wū",
   "len": 5
  },
  {
   "id": "s051",
   "region": 3,
   "text": "鸟在林，娃在屋。",
   "focus": "林",
   "py": "niǎo zài lín wá zài wū",
   "len": 6
  },
  {
   "id": "s052",
   "region": 3,
   "text": "森林是鸟的家。",
   "focus": "森",
   "py": "sēn lín shì niǎo de jiā",
   "len": 6
  },
  {
   "id": "s053",
   "region": 3,
   "text": "娃去坐木马。",
   "focus": "马",
   "py": "wá qù zuò mù mǎ",
   "len": 5
  },
  {
   "id": "s054",
   "region": 3,
   "text": "鸡看见了虫。",
   "focus": "鸡",
   "py": "jī kàn jiàn le chóng",
   "len": 5
  },
  {
   "id": "s055",
   "region": 3,
   "text": "草地有花有虫。",
   "focus": "草",
   "py": "cǎo dì yǒu huā yǒu chóng",
   "len": 6
  },
  {
   "id": "s056",
   "region": 3,
   "text": "妈和娃去湖看鱼。",
   "focus": "鱼",
   "py": "mā hé wá qù hú kàn yú",
   "len": 7
  },
  {
   "id": "s057",
   "region": 3,
   "text": "青蛙好绿呀！",
   "focus": "蛙",
   "py": "qīng wā hǎo lǜ ya",
   "len": 5
  },
  {
   "id": "s058",
   "region": 3,
   "text": "我家有猫和狗。",
   "focus": "狗",
   "py": "wǒ jiā yǒu māo hé gǒu",
   "len": 6
  },
  {
   "id": "s059",
   "region": 3,
   "text": "白兔穿白衣。",
   "focus": "兔",
   "py": "bái tù chuān bái yī",
   "len": 5
  },
  {
   "id": "s060",
   "region": 3,
   "text": "妈的马尾好黑。",
   "focus": "尾",
   "py": "mā de mǎ wěi hǎo hēi",
   "len": 6
  },
  {
   "id": "s061",
   "region": 3,
   "text": "竹叶青青的。",
   "focus": "竹",
   "py": "zhú yè qīng qīng de",
   "len": 5
  },
  {
   "id": "s062",
   "region": 3,
   "text": "它是乌鸦吗？",
   "focus": "鸦",
   "py": "tā shì wū yā ma",
   "len": 5
  },
  {
   "id": "s063",
   "region": 3,
   "text": "花猫爬树。",
   "focus": "爬",
   "py": "huā māo pá shù",
   "len": 4
  },
  {
   "id": "s064",
   "region": 3,
   "text": "白鹅白，乌鸦黑。",
   "focus": "鹅",
   "py": "bái é bái wū yā hēi",
   "len": 6
  },
  {
   "id": "s065",
   "region": 4,
   "text": "妈妈给我红苹果。",
   "focus": "给",
   "py": "mā ma gěi wǒ hóng píng guǒ",
   "len": 7
  },
  {
   "id": "s066",
   "region": 4,
   "text": "白菜白，青菜青。",
   "focus": "菜",
   "py": "bái cài bái qīng cài qīng",
   "len": 6
  },
  {
   "id": "s067",
   "region": 4,
   "text": "奶奶的白粥好了！",
   "focus": "粥",
   "py": "nǎi nai de bái zhōu hǎo le",
   "len": 7
  },
  {
   "id": "s068",
   "region": 4,
   "text": "鸡妈妈有蛋！",
   "focus": "蛋",
   "py": "jī mā ma yǒu dàn",
   "len": 5
  },
  {
   "id": "s069",
   "region": 4,
   "text": "我有糖，你有吗？",
   "focus": "糖",
   "py": "wǒ yǒu táng nǐ yǒu ma",
   "len": 6
  },
  {
   "id": "s070",
   "region": 4,
   "text": "是盐还是糖？",
   "focus": "盐",
   "py": "shì yán hái shì táng",
   "len": 5
  },
  {
   "id": "s071",
   "region": 4,
   "text": "油是黄的吗？",
   "focus": "油",
   "py": "yóu shì huáng de ma",
   "len": 5
  },
  {
   "id": "s072",
   "region": 4,
   "text": "饼给弟弟吧。",
   "focus": "饼",
   "py": "bǐng gěi dì dì ba",
   "len": 5
  },
  {
   "id": "s073",
   "region": 4,
   "text": "蛋饺好了吗？",
   "focus": "饺",
   "py": "dàn jiǎo hǎo le ma",
   "len": 5
  },
  {
   "id": "s074",
   "region": 4,
   "text": "虾给猫吧。",
   "focus": "虾",
   "py": "xiā gěi māo ba",
   "len": 4
  },
  {
   "id": "s075",
   "region": 4,
   "text": "蛋糕来了！",
   "focus": "糕",
   "py": "dàn gāo lái le",
   "len": 4
  },
  {
   "id": "s076",
   "region": 4,
   "text": "梨是妈妈的！",
   "focus": "梨",
   "py": "lí shì mā ma de",
   "len": 5
  },
  {
   "id": "s077",
   "region": 4,
   "text": "枣树好高呀！",
   "focus": "枣",
   "py": "zǎo shù hǎo gāo ya",
   "len": 5
  },
  {
   "id": "s078",
   "region": 4,
   "text": "葡萄是紫的吗？",
   "focus": "萄",
   "py": "pú tao shì zǐ de ma",
   "len": 6
  },
  {
   "id": "s079",
   "region": 4,
   "text": "妈妈去买菜。",
   "focus": "买",
   "py": "mā ma qù mǎi cài",
   "len": 5
  },
  {
   "id": "s080",
   "region": 4,
   "text": "叔叔卖鱼和虾。",
   "focus": "卖",
   "py": "shū shu mài yú hé xiā",
   "len": 6
  },
  {
   "id": "s081",
   "region": 4,
   "text": "碗是我的！",
   "focus": "碗",
   "py": "wǎn shì wǒ de",
   "len": 4
  },
  {
   "id": "s082",
   "region": 5,
   "text": "月亮在水中。",
   "focus": "中",
   "py": "yuè liàng zài shuǐ zhōng",
   "len": 5
  },
  {
   "id": "s083",
   "region": 5,
   "text": "我在桥上看鱼。",
   "focus": "桥",
   "py": "wǒ zài qiáo shàng kàn yú",
   "len": 6
  },
  {
   "id": "s084",
   "region": 5,
   "text": "坐车去看爷爷。",
   "focus": "车",
   "py": "zuò chē qù kàn yé ye",
   "len": 6
  },
  {
   "id": "s085",
   "region": 5,
   "text": "去奶奶家的路好远。",
   "focus": "路",
   "py": "qù nǎi nai jiā de lù hǎo yuǎn",
   "len": 8
  },
  {
   "id": "s086",
   "region": 5,
   "text": "红灯亮了，我看见了。",
   "focus": "灯",
   "py": "hóng dēng liàng le wǒ kàn jiàn le",
   "len": 8
  },
  {
   "id": "s087",
   "region": 5,
   "text": "和妈妈在路上走。",
   "focus": "走",
   "py": "hé mā ma zài lù shàng zǒu",
   "len": 7
  },
  {
   "id": "s088",
   "region": 5,
   "text": "水里有鱼和虾。",
   "focus": "里",
   "py": "shuǐ lǐ yǒu yú hé xiā",
   "len": 6
  },
  {
   "id": "s089",
   "region": 5,
   "text": "船在水上走。",
   "focus": "船",
   "py": "chuán zài shuǐ shàng zǒu",
   "len": 5
  },
  {
   "id": "s090",
   "region": 5,
   "text": "东湖里有莲花。",
   "focus": "东",
   "py": "dōng hú lǐ yǒu lián huā",
   "len": 6
  },
  {
   "id": "s091",
   "region": 5,
   "text": "南山上有白马。",
   "focus": "南",
   "py": "nán shān shàng yǒu bái mǎ",
   "len": 6
  },
  {
   "id": "s092",
   "region": 5,
   "text": "日头下西山。",
   "focus": "西",
   "py": "rì tóu xià xī shān",
   "len": 5
  },
  {
   "id": "s093",
   "region": 5,
   "text": "北山下了雪，好白呀！",
   "focus": "北",
   "py": "běi shān xià le xuě hǎo bái ya",
   "len": 8
  },
  {
   "id": "s094",
   "region": 5,
   "text": "我走在妈妈前头。",
   "focus": "前",
