{"region":7,"sentences":[
{"id":"s126","region":7,"text":"我有一只花猫。","focus":"只","py":"wǒ yǒu yī zhī huā māo","len":6},
{"id":"s127","region":7,"text":"妈妈买了一双红鞋。","focus":"双","py":"mā ma mǎi le yī shuāng hóng xié","len":8},
{"id":"s128","region":7,"text":"我的爸爸有力气。","focus":"力","py":"wǒ de bà ba yǒu lì qì","len":7},
{"id":"s129","region":7,"text":"晚上的湖水好美。","focus":"美","py":"wǎn shàng de hú shuǐ hǎo měi","len":7},
{"id":"s130","region":7,"text":"我站起来看星星。","focus":"起","py":"wǒ zhàn qǐ lái kàn xīng xing","len":7},
{"id":"s131","region":7,"text":"妈妈给我打伞。","focus":"打","py":"mā ma gěi wǒ dǎ sǎn","len":6},
{"id":"s132","region":7,"text":"我的手小，妈妈的手大。","focus":"大","py":"wǒ de shǒu xiǎo mā ma de shǒu dà","len":9},
{"id":"s133","region":7,"text":"小鸟飞上天找妈妈。","focus":"飞","py":"xiǎo niǎo fēi shàng tiān zhǎo mā ma","len":8},
{"id":"s134","region":7,"text":"我会写我的名字。","focus":"会","py":"wǒ huì xiě wǒ de míng zi","len":7},
{"id":"s135","region":7,"text":"我有一个好妈妈。","focus":"个","py":"wǒ yǒu yī gè hǎo mā ma","len":7},
{"id":"s136","region":7,"text":"小兔去山上采花。","focus":"采","py":"xiǎo tù qù shān shàng cǎi huā","len":7},
{"id":"s137","region":7,"text":"妈妈说，宝贝睡吧。","focus":"说","py":"mā ma shuō bǎo bèi shuì ba","len":7},
{"id":"s138","region":7,"text":"弯弯的月亮在天上。","focus":"弯","py":"wān wān de yuè liàng zài tiān shàng","len":8},
{"id":"s139","region":7,"text":"我和朋友一起玩。","focus":"友","py":"wǒ hé péng you yī qǐ wán","len":7},
{"id":"s140","region":7,"text":"我和妹妹比写字。","focus":"比","py":"wǒ hé mèi mei bǐ xiě zì","len":7},
{"id":"s141","region":7,"text":"书包是谁的呀？","focus":"谁","py":"shū bāo shì shuí de ya","len":6},
{"id":"s142","region":7,"text":"晚上的月亮最亮。","focus":"最","py":"wǎn shàng de yuè liàng zuì liàng","len":7},
{"id":"s143","region":7,"text":"马尾长，兔尾短。","focus":"短","py":"mǎ wěi cháng tù wěi duǎn","len":6},
{"id":"s144","region":7,"text":"我把糖给妹妹。","focus":"把","py":"wǒ bǎ táng gěi mèi mei","len":6},
{"id":"s145","region":7,"text":"天上下了小雨点。","focus":"点","py":"tiān shàng xià le xiǎo yǔ diǎn","len":7},
{"id":"s146","region":7,"text":"天要黑了，我们回家。","focus":"要","py":"tiān yào hēi le wǒ men huí jiā","len":8},
{"id":"s147","region":7,"text":"妈妈买了一串紫葡萄。","focus":"串","py":"mā ma mǎi le yī chuàn zǐ pú tao","len":9},
{"id":"s148","region":7,"text":"我找到好朋友了。","focus":"到","py":"wǒ zhǎo dào hǎo péng you le","len":7},
{"id":"s149","region":7,"text":"我们玩了半天，好开心。","focus":"半","py":"wǒ men wán le bàn tiān hǎo kāi xīn","len":9},
{"id":"s150","region":7,"text":"我问妈妈，星星有几个？","focus":"问","py":"wǒ wèn mā ma xīng xīng yǒu jǐ gè","len":9},
{"id":"s151","region":7,"text":"山的那边是我的家。","focus":"那","py":"shān de nà biān shì wǒ de jiā","len":8},
{"id":"s152","region":7,"text":"我的朋友真好。","focus":"真","py":"wǒ de péng you zhēn hǎo","len":6},
{"id":"s153","region":7,"text":"我们一同去上学。","focus":"同","py":"wǒ men yī tóng qù shàng xué","len":7},
{"id":"s154","region":7,"text":"读书真快乐。","focus":"快","py":"dú shū zhēn kuài lè","len":5},
{"id":"s155","region":7,"text":"妹妹笑了又笑。","focus":"笑","py":"mèi mei xiào le yòu xiào","len":6},
{"id":"s156","region":7,"text":"弟弟哭了，又笑了。","focus":"哭","py":"dì dì kū le yòu xiào le","len":7},
{"id":"s157","region":7,"text":"梦里我飞到月亮上。","focus":"梦","py":"mèng lǐ wǒ fēi dào yuè liang shàng","len":8},
{"id":"s158","region":7,"text":"我帮妈妈买菜。","focus":"帮","py":"wǒ bāng mā ma mǎi cài","len":6},
{"id":"s159","region":7,"text":"我给小猫喝水，它笑了。","focus":"喝","py":"wǒ gěi xiǎo māo hē shuǐ tā xiào le","len":9},
{"id":"s160","region":7,"text":"你猜我是谁？","focus":"猜","py":"nǐ cāi wǒ shì shuí","len":5}
]}
