{"region":1,"sentences":[
{"id":"s001","region":1,"text":"风来了，雪来了。","focus":"雪","py":"fēng lái le xuě lái le","len":6},
{"id":"s002","region":1,"text":"云是白的，雪还是白的。","focus":"白","py":"yún shì bái de xuě hái shì bái de","len":9},
{"id":"s003","region":1,"text":"山有树和水。","focus":"树","py":"shān yǒu shù hé shuǐ","len":5},
{"id":"s004","region":1,"text":"秋风来了，树叶红了。","focus":"叶","py":"qiū fēng lái le shù yè hóng le","len":8},
{"id":"s005","region":1,"text":"月和星来了。","focus":"星","py":"yuè hé xīng lái le","len":5},
{"id":"s006","region":1,"text":"我们去看红叶吧。","focus":"看","py":"wǒ men qù kàn hóng yè ba","len":7},
{"id":"s007","region":1,"text":"我看见山和水了。","focus":"见","py":"wǒ kàn jiàn shān hé shuǐ le","len":7},
{"id":"s008","region":1,"text":"江水闪呀闪。","focus":"江","py":"jiāng shuǐ shǎn ya shǎn","len":5},
{"id":"s009","region":1,"text":"春天来了，我们去看莲。","focus":"春","py":"chūn tiān lái le wǒ men qù kàn lián","len":9},
{"id":"s010","region":1,"text":"日来了，树有影了。","focus":"影","py":"rì lái le shù yǒu yǐng le","len":7},
{"id":"s011","region":1,"text":"云黑了，雨来了。","focus":"黑","py":"yún hēi le yǔ lái le","len":6},
{"id":"s012","region":1,"text":"看呀，天有彩云！","focus":"彩","py":"kàn ya tiān yǒu cǎi yún","len":6},
{"id":"s013","region":1,"text":"春来了，树绿了。","focus":"绿","py":"chūn lái le shù lǜ le","len":6},
{"id":"s014","region":1,"text":"海水来了，海水去了。","focus":"海","py":"hǎi shuǐ lái le hǎi shuǐ qù le","len":8},
{"id":"s015","region":1,"text":"天黑了，月亮来了。","focus":"亮","py":"tiān hēi le yuè liàng lái le","len":7},
{"id":"s016","region":1,"text":"山有洞，洞好黑。","focus":"洞","py":"shān yǒu dòng dòng hǎo hēi","len":6},
{"id":"s017","region":1,"text":"山好高呀，树好绿。","focus":"高","py":"shān hǎo gāo ya shù hǎo lǜ","len":7},
{"id":"s018","region":1,"text":"天晚了，山黑了。","focus":"晚","py":"tiān wǎn le shān hēi le","len":6},
{"id":"s019","region":1,"text":"午来了，日好亮呀。","focus":"午","py":"wǔ lái le rì hǎo liàng ya","len":7},
{"id":"s020","region":1,"text":"今天天好蓝呀。","focus":"今","py":"jīn tiān tiān hǎo lán ya","len":6},
{"id":"s021","region":1,"text":"今年的雪好白呀。","focus":"年","py":"jīn nián de xuě hǎo bái ya","len":7},
{"id":"s022","region":1,"text":"雾来了，山看不见了。","focus":"雾","py":"wù lái le shān kàn bu jiàn le","len":8},
{"id":"s023","region":1,"text":"湖水绿，湖水亮。","focus":"湖","py":"hú shuǐ lǜ hú shuǐ liàng","len":6},
{"id":"s024","region":1,"text":"海岛有树，还有雾。","focus":"岛","py":"hǎi dǎo yǒu shù hái yǒu wù","len":7},
{"id":"s025","region":1,"text":"我们去江岸看水。","focus":"岸","py":"wǒ men qù jiāng àn kàn shuǐ","len":7},
{"id":"s026","region":1,"text":"海岛的沙好白。","focus":"沙","py":"hǎi dǎo de shā hǎo bái","len":6}
]}
